# ==========================================
# Environments & Virtual Environments
# ==========================================
.venv/
*/.venv/
*/*/.venv/
*/*/*/.venv/
venv/
env/
ENV/

# ==========================================
# Python Bytecode & Cache
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.pytest_cache/
.coverage
htmlcov/

# ==========================================
# Large Video / Test Files
# (GitHub rejects files > 100MB; video files should not be in git)
# ==========================================
*.avi
*.mov
*.mkv
*.webm
sih-vehicle-intelligence/data/*.mp4
traffic-test/assets/*.mp4

# ==========================================
# Large Dataset Files (METR-LA dataset is ~57MB)
# ==========================================
*.h5
*.hdf5
*.pkl

# ==========================================
# Node.js & Frontend Builds
# ==========================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.next/
out/
build/
dist/

# ==========================================
# Temporary Runtime Files
# ==========================================
.services_pids.txt
*.log
.DS_Store
Thumbs.db
desktop.ini

# ==========================================
# Environment Variables & Secrets
# ==========================================
.env
.env.*
!.env.example
